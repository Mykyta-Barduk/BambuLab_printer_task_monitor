// backend/prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. ТАБЛИЦЯ КОТУШОК ПЛАСТИКУ
model Spool {
  id               String   @id
  materialType     String
  colorName        String
  colorHex         String
  totalWeightG     Int
  remainingWeightG Int
  createdAt        DateTime @default(now())
  printers         Printer[]
}

// 2. ТАБЛИЦЯ ПРИНТЕРІВ
model Printer {
  id             String      @id
  name           String
  model          String
  status         String      @default("idle")
  currentSpoolId String?
  currentSpool   Spool?      @relation(fields: [currentSpoolId], references: [id], onDelete: SetNull)
  printTasks     PrintTask[]
}

// 3. ТАБЛИЦЯ ЧЕРГИ ЗАДАНЬ
model PrintTask {
  id                Int       @id @default(autoincrement())
  modelName         String    // Ім'я файлу з Google Диску
  userEmail         String
  username          String
  priority          String    @default("MEDIUM") // Сюди залітатиме LOW, MEDIUM або HIGH
  materialType      String    @default("PLA")    // 🔥 ДОДАЛИ ЦЕ ПОЛЕ (PLA, PETG, ABS...)
  requestedColor    String    @default("Any")    // Колір (Білий, Чорний...)
  quantity          Int       @default(1)        // Кількість штук
  comment           String?                      // Хотілки замовника
  gdriveFileLink    String?   
  gdriveFolderLink  String?   

  status            String    @default("pending")
  estimatedWeightG  Float?
  totalDurationMins Int?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  printerId         String?
  printer           Printer?  @relation(fields: [printerId], references: [id])
}