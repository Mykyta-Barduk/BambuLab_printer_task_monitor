// backend/prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. ТАБЛИЦЯ КОРИСТУВАЧІВ (Адміни та Студенти)
model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique // Логін без пароля (сюди залітає email з Google Форми)
  role      String      @default("CUSTOMER") // "CUSTOMER" або "ADMIN"
  createdAt DateTime    @default(now())
  
  printTasks PrintTask[] // Зв'язок: один користувач може мати багато замовлень
}

// 2. ТАБЛИЦЯ КОТУШОК ПЛАСТИКУ (Твоя оригінальна логіка)
model Spool {
  id               String    @id
  materialType     String
  colorName        String
  colorHex         String
  totalWeightG     Int
  remainingWeightG Int
  createdAt        DateTime  @default(now())
  printers         Printer[]
}

// 3. ТАБЛИЦЯ ПРИНТЕРІВ
model Printer {
  id             String     @id // Серійник принтера
  name           String
  model          String
  status         String     @default("idle")
  
  progress       Int        @default(0)    // Відсоток друку (0-100)
  remainingMins  Int        @default(0)    // Скільки хвилин залишилось
  nozzleTemp     Int        @default(0)    // Поточна температура сопла
  bedTemp        Int        @default(0)    // Поточна температура столу

  currentSpoolId String?
  currentSpool   Spool?     @relation(fields: [currentSpoolId], references: [id], onDelete: SetNull)
  
  printJobs      PrintJob[] // Зв'язок: принтер має історію фізичних запусків
}

// 4. ТАБЛИЦЯ ЗБІРОК (Один фізичний запуск друку, який ловить MQTT)
model PrintJob {
  id            String      @id @default(cuid()) // Унікальний ID сесії друку
  fileName      String      // Назва файлу/завдання з MQTT
  status        String      @default("printing") // printing, waiting_confirmation, finished, failed
  
  // 🔥 ДОДАНІ ПОЛЯ ДЛЯ ДИНАМІЧНОЇ ТЕЛЕМЕТРІЇ:
  progress      Int         @default(0)    // Поточний відсоток з Bambu Lab
  remainingMins Int         @default(0)    // Залишок часу у хвилинах
  nozzleTemp    Int         @default(0)
  bedTemp       Int         @default(0)

  startedAt     DateTime    @default(now())
  finishedAt    DateTime?

  printerId     String
  printer       Printer     @relation(fields: [printerId], references: [id])

  printTasks    PrintTask[] // Зв'язок із чергою тасок
}

// 5. ТАБЛИЦЯ ЧЕРГИ ЗАДАНЬ (Модернізована під нову архітектуру)
model PrintTask {
  id                Int       @id @default(autoincrement())
  modelName         String    // Ім'я файлу з Google Диску
  
  // Зв'язуємо таску з таблицею User через email
  userEmail         String
  user              User      @relation(fields: [userEmail], references: [email])
  username          String    // Чисте ім'я до знаку @
  
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  materialType      String    @default("PLA")    // PLA, PETG, ABS...
  requestedColor    String    @default("Any")    
  quantity          Int       @default(1)        
  comment           String?                      
  gdriveFileLink    String?   
  gdriveFolderLink  String?   

  status            String    @default("pending") // pending, printing, finished, failed
  estimatedWeightG  Float?
  totalDurationMins Int?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Замість прямої прив'язки до принтера, таска прив'язується до конкретної збірки на столі (PrintJob)
  printJobId        String?
  printJob          PrintJob? @relation(fields: [printJobId], references: [id], onDelete: SetNull)
}